configuration {
    modi: "drun,run,window";
    show-icons: false;
    font: "monospace 12";
    dpi: 0;
    display-drun: "";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
}

* {
    /* Gruvbox Material Hard Dark Palette */
    bg:          #1d2021;
    bg-opacity:  #1d2021e6; /* 0.9 opacity */
    bg-alt:      #32302f;
    fg:          #d4be98;
    fg-muted:    #928374;

    red:         #ea6962;
    green:       #a9b665;
    yellow:      #d8a657;
    blue:        #7daea3;
    magenta:     #d3869b;
    cyan:        #89b482;

    background-color: transparent;
    text-color:       @fg;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    background-color: @bg-opacity;
    border:           2px;
    border-color:     @yellow;
    border-radius:    8px;
    width:            42%;
    padding:          12px;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius:    6px;
    padding:          8px 12px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @green;
    font:       "monospace Bold 18";
}

entry {
    placeholder:       "Search...";
    placeholder-color: @fg-muted;
    vertical-align:    0.5;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      3px;
}

element {
    padding:       6px 8px;
    border-radius: 6px;
    spacing:       8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @yellow;
    text-color:       @bg;
}

element normal.urgent,
element alternate.urgent {
    text-color: @red;
}

element selected.urgent {
    background-color: @red;
    text-color:       @bg;
}

element normal.active,
element alternate.active {
    text-color: @cyan;
}

element selected.active {
    background-color: @cyan;
    text-color:       @bg;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

